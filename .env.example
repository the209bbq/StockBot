# Alpaca PAPER trading keys only.
# Generate them at https://app.alpaca.markets after switching to the Paper account.
# Never commit a real .env file.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Must stay on the paper endpoint. Any other value is rejected.
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Kill switch: set to 1/true/yes to block every order (also honored if .killswitch exists).
# KILL_SWITCH=1

# Optional Discord alerts (fills, errors, kill switch, drift). No-op if unset.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional email alerts. No-op if NOTIFY_EMAIL_TO is unset.
# NOTIFY_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=stockbot@example.com
# SMTP_USE_TLS=1
